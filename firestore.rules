rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check: Admin logs in with Email/Password (provider == 'password') or specific admin email
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider == 'password' ||
        request.auth.token.email == 'aihorizon@admin.com'
      );
    }

    // Events Collection
    match /events/{eventId} {
      // Event info (name, form fields, active status) is readable by everyone to display registration form
      allow read: if true;
      allow write: if isAdmin();
      
      match /registrations/{registrationId} {
        // GET (single document by ID):
        // - Admin can read any registration
        // - Signed-in user can read their OWN registration
        // - Manual registration (userId == null) can be read by anyone with the token URL
        allow get: if isAdmin() || (
          request.auth != null && resource.data.userId == request.auth.uid
        ) || (
          resource.data.userId == null
        );
        
        // LIST (query across documents):
        // - Admin can query all registrations
        // - Signed-in user can ONLY query registrations where userId matches their own UID.
        // - Manual registrations (userId == null) can be queried (token acts as auth)
        allow list: if isAdmin() || (
          request.auth != null && resource.data.userId == request.auth.uid
        ) || (
          resource.data.userId == null
        );
        
        // Create:
        // - Signed-in users can create a registration attached to their own UID
        // - Unauthenticated users can create a registration with userId == null (manual email flow)
        allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) ||
                        (request.resource.data.userId == null);
        
        // Update:
        // - Admin can update anything.
        // - Signed-in user can ONLY update their OWN details IF present == false,
        //   and they CANNOT modify their attendance status (present / checkedInAt).
        // - Manual registration (userId == null) can be updated IF present == false,
        //   and attendance status is not modified (token URL acts as auth).
        allow update: if isAdmin() || (
          request.auth != null &&
          resource.data.userId == request.auth.uid &&
          resource.data.present == false &&
          request.resource.data.present == false &&
          request.resource.data.checkedInAt == resource.data.checkedInAt
        ) || (
          resource.data.userId == null &&
          resource.data.present == false &&
          request.resource.data.present == false &&
          request.resource.data.checkedInAt == resource.data.checkedInAt
        );
        
        // ONLY Admin can delete registrations
        allow delete: if isAdmin();
      }
    }

    // Settings Collection
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}