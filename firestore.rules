rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is the admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'aihorizon@admin.com';
    }

    // ----- NEW STRUCTURE (Multi-Event System) -----
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /registrations/{registrationId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if isAdmin();
      }
    }

    // ----- OLD STRUCTURE (Stops errors on Cloudflare until you push the new code) -----
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}